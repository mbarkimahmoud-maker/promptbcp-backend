# ============================================
# CONFIGURATION DOCKER — PROMPT MANAGER BP
# ============================================
# Copiez ce fichier et renommez-le ".env.docker"
# Puis remplissez les valeurs avec vos propres informations

APP_NAME="Prompt Manager BP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ============================================
# BASE DE DONNÉES — ne pas modifier (config Docker interne)
# ============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=promptBCP
DB_USERNAME=root
DB_PASSWORD=root

# ============================================
# INTELLIGENCE ARTIFICIELLE — GEMINI (gratuit)
# ============================================
# 1. Allez sur https://aistudio.google.com/
# 2. Connectez-vous avec un compte Google
# 3. Cliquez sur "Get API Key" puis "Create API Key"
# 4. Collez la clé ci-dessous
GEMINI_API_KEY=collez_votre_cle_gemini_ici
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# ============================================
# INTELLIGENCE ARTIFICIELLE — GROQ (gratuit, rapide)
# ============================================
# 1. Allez sur https://console.groq.com/
# 2. Connectez-vous (Google, GitHub, ou email)
# 3. Allez dans "API Keys" → "Create API Key"
# 4. Collez la clé ci-dessous
GROQ_API_KEY=collez_votre_cle_groq_ici
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ============================================
# ENVOI D'EMAILS
# ============================================
# Option recommandée : Gmail avec mot de passe d'application
# 1. Allez sur https://myaccount.google.com/security
# 2. Activez la "Vérification en 2 étapes" si pas déjà fait
# 3. Allez sur https://myaccount.google.com/apppasswords
# 4. Créez un mot de passe d'application et collez-le ci-dessous (sans espaces)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application_sans_espaces
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=votre_email@gmail.com
MAIL_FROM_NAME="Prompt Manager BP"

# ============================================
# AUTRES PARAMÈTRES — ne pas modifier
# ============================================
LOG_CHANNEL=stack
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local